
# завдання 4

import tkinter as tk
import student_utils


def generate_report():
    value = count_entry.get().strip()

    if not value.isdecimal():
        result.delete("1.0", tk.END)
        result.insert(tk.END, "Введіть ціле число від 1 до 20")
        return

    count = int(value)

    if count < 1 or count > 20:
        result.delete("1.0", tk.END)
        result.insert(tk.END, "Кількість має бути від 1 до 20")
        return

    students = ["Anna", "Ivan", "Olha"]
    report = ""

    for name in students:
        grades = student_utils.generate_grades(count)
        average = student_utils.average_grade(grades)
        level = student_utils.get_level(average)

        report += name + ": " + str(grades)
        report += " → " + str(round(average, 2))
        report += " → " + level + "\n"

    print(report)

    result.delete("1.0", tk.END)
    result.insert(tk.END, report)


window = tk.Tk()
window.title("Статистика учнів")
window.geometry("500x350")

tk.Label(window, text="Кількість оцінок (1–20):").pack(pady=5)

count_entry = tk.Entry(window)
count_entry.pack(pady=5)

tk.Button(
    window,
    text="Сформувати звіт",
    command=generate_report
).pack(pady=10)

result = tk.Text(window, height=10, width=55)
result.pack(pady=10)

window.mainloop()
